  </div>

  <table class="blocking-table">
    <tr>
      <td>0001 OFAC BLOCKED</td>
      <td>0002 OFAC RESTRICTED</td>
      <td>0021 NON-OFAC SANCTIONS BLOCK</td>
      <td>0003 BLOCK AND CERTIFY</td>
    </tr>
    <tr>
      <td>0005 THIRD PARTY PAYMENT</td>
      <td>0006 FINANCIAL INTELLIGENCE UNIT (FIU) BLOCK</td>
      <td>0007 CID RENEWAL</td>
      <td>0008 EXPIRED KYC EXCEPTION</td>
    </tr>
    <tr>
      <td>0010 SUBPOENA</td>
      <td>0011 VOLUNTARY LIQUIDATION</td>
